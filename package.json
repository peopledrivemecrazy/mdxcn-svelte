{
	"name": "mdxcn-svelte",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest --run",
		"parity": "node scripts/parity.mjs"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./theme.css": "./dist/theme.css",
		"./tokens.css": "./dist/tokens.css",
		"./*": {
			"types": "./dist/registry/*/index.d.ts",
			"svelte": "./dist/registry/*/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.29.0",
		"tailwindcss": "^4.0.0"
	},
	"devDependencies": {
		"@comark/svelte": "^0.7.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser": "5.0.2",
		"@vitest/browser-playwright": "^5.0.2",
		"comark": "^0.7.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"knap": "^0.6.0",
		"playwright": "^1.63.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"publint": "^0.3.21",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "5.0.2",
		"vitest-browser-svelte": "^3.1.0"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"ascii",
		"charts",
		"tables",
		"diagrams",
		"markdown",
		"mdsvex",
		"comark",
		"tailwindcss"
	],
	"dependencies": {
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.7.0"
	},
	"description": "Svelte 5 components for ASCII-style tables, charts, and diagrams. A port of mdxcn.",
	"license": "MIT",
	"author": {
		"name": "Shriji",
		"url": "https://github.com/peopledrivemecrazy"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/peopledrivemecrazy/mdxcn-svelte.git"
	},
	"homepage": "https://github.com/peopledrivemecrazy/mdxcn-svelte#readme",
	"bugs": {
		"url": "https://github.com/peopledrivemecrazy/mdxcn-svelte/issues"
	},
	"peerDependenciesMeta": {
		"tailwindcss": {
			"optional": true
		}
	}
}
